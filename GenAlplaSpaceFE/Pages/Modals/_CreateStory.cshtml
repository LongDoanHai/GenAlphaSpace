                        <h3 class="text-base font-normal dark:text-white">Drag photo here</h3>
                        
                        <label class="mt-2 px-4 py-1.5 bg-sky-500 hover:bg-sky-600 text-white rounded-lg font-bold text-sm transition-all cursor-pointer">
                            Choose from computer
                            <input id="createStatusUrl" name="uploadedContent" type="file" accept="image/png, image/jpeg" class="hidden" />
                        </label>
                    </div>

                    <!-- Preview Container -->
                    <div id="preview-container" class="hidden absolute inset-0 bg-black flex items-center justify-center z-30">
                        <img id="createStatusImage" class="w-full h-full object-cover" />
                    </div>

                </div>

                <div class="py-3 px-4 border-t border-slate-100 dark:border-slate-700">
                    <p class="text-[11px] text-slate-400 text-center">
                        Visible for 24 hours
                    </p>
                </div>
            </form>
        </div>

    </div>
</div>

<script src="~/js/Modals/_CreateStory.js"></script>
