        <!-- Header -->
        <div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex items-center justify-center relative min-h-[50px]">
            <!-- Back Arrow -->
            <button type="button" id="btnBackToUpload" class="absolute left-4 text-slate-900 dark:text-white hidden hover:opacity-70 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
            </button>
            
            <h2 class="text-sm font-bold text-slate-900 dark:text-white">Create New Story</h2>
            
            <!-- Next Button -->
            <button type="submit" form="createStoryForm" id="btnCreateStory" class="absolute right-4 text-sky-500 font-bold hover:text-sky-600 transition-all text-sm hidden">
                Next
            </button>
        </div>

        <div class="p-0"> 
