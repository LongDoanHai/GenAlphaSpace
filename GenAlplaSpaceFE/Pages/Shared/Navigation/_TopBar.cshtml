<header class="z-[100] h-[--m-top] fixed top-0 left-0 w-full flex items-center bg-white/90 sky-50 backdrop-blur-xl shadow-sm border-b border-slate-100/80">
	<div class="2xl:w-[--w-side] lg:w-[--w-side-sm]">
		<div class="flex items-center gap-1">
			<button uk-toggle="target: #site__sidebar ; cls :!-translate-x-0"
					class="flex items-center justify-center w-9 h-9 text-xl rounded-xl hover:bg-slate-100 active:bg-slate-200 transition-all duration-200 xl:hidden group">
				<ion-icon name="menu-outline" class="text-2xl text-slate-600 group-aria-expanded:hidden"></ion-icon>
				<ion-icon name="close-outline" class="hidden text-2xl text-slate-600 group-aria-expanded:block"></ion-icon>
			</button>

			<div id="logo" class="flex items-center">
				<a class="flex items-center gap-2 group">
					<img src="~/images/logo.png" class="w-9 md:block hidden transition-transform duration-200 group-hover:scale-105" />
					<span class="font-semibold text-gray-800 tracking-tight text-lg group-hover:text-sky-600 transition-colors duration-200">GenAlphaSpace</span>
				</a>
			</div>

		</div>
	</div>
	<div class="flex-1 relative">
		<div class="max-w-[1220px] mx-auto flex items-center">
			<form id="search--box"
				  class="xl:w-[680px] sm:w-96 sm:relative rounded-xl overflow-hidden z-20 bg-slate-100 border border-slate-200/60 focus-within:border-sky-400 focus-within:ring-2 focus-within:ring-sky-100 focus-within:bg-white max-md:hidden w-screen left-0 max-sm:fixed max-sm:top-2 transition-all duration-200">

				<ion-icon name="search" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-lg"></ion-icon>
				<input type="text" name="query" placeholder="Search Posts, Friends..." class="w-full !pl-10 !font-normal !bg-transparent h-11 !text-sm !text-slate-600 placeholder:text-slate-400 focus:outline-none" />
			</form>
		</div>

		<div class="max-w-[1220px] mx-auto flex items-center">
			<div class="flex items-center sm:gap-4 gap-2 absolute right-5 top-1/2 -translate-y-1/2 text-black">

				@* notification icon *@
				<button type="button" class="sm:p-2.5 p-2 rounded-xl relative bg-slate-100 hover:bg-slate-200 active:bg-slate-300 transition-all duration-200 hover:scale-105 group">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-slate-600 group-hover:text-slate-800 transition-colors duration-200 max-sm:hidden">
						<path d="M5.85 3.5a.75.75 0 00-1.117-1 9.719 9.719 0 00-2.348 4.876.75.75 0 001.479.248A8.219 8.219 0 015.85 3.5zM19.267 2.5a.75.75 0 10-1.118 1 8.22 8.22 0 011.987 4.124.75.75 0 001.48-.248A9.72 9.72 0 0019.266 2.5z" />
						<path fill-rule="evenodd" d="M12 2.25A6.75 6.75 0 005.25 9v.75a8.217 8.217 0 01-2.119 5.52.75.75 0 00.298 1.206c1.544.57 3.16.99 4.831 1.243a3.75 3.75 0 107.48 0 24.583 24.583 0 004.83-1.244.75.75 0 00.298-1.205 8.217 8.217 0 01-2.118-5.52V9A6.75 6.75 0 0012 2.25zM9.75 18c0-.034 0-.067.002-.1a25.05 25.05 0 004.496 0l.002.1a2.25 2.25 0 11-4.5 0z" clip-rule="evenodd" />
					</svg>
					<div class="absolute -top-1 -right-1 bg-red-600 text-white text-[9px] font-bold min-w-[16px] h-[16px] px-0.5 rounded-full flex items-center justify-center shadow-sm ring-1 ring-white antialiased" id="notificationsCount">0</div>
				</button>

				<div class="hidden bg-white pr-1.5 rounded-xl shadow-lg shadow-slate-200/50 border border-slate-100 md:w-[365px] w-screen" uk-drop="offset:8;pos: bottom-right; mode: click; animate-out: true;">

					<div class="flex items-center justify-between gap-2 p-4 pb-3">
						<h3 class="font-bold text-lg text-slate-800">Notifications</h3>
					</div>

					<div class="text-sm h-[400px] w-full overflow-y-auto pr-2">
						<div class="pl-2 p-1 text-sm font-normal text-slate-500" id="notification-dropdown">
							No notifications...
						</div>
					</div>

				</div>

				<div class="rounded-xl relative bg-slate-100 hover:bg-slate-200 cursor-pointer shrink-0 ring-2 ring-transparent hover:ring-sky-200 transition-all duration-200 group p-0.5">
					<img src="~/images/avatar/person.png" class="sm:w-8 sm:h-8 w-7 h-7 rounded-lg shadow-sm object-cover shrink-0 group-hover:scale-105 transition-transform duration-200" />
				</div>
				<div class="hidden bg-white rounded-xl shadow-lg shadow-slate-200/50 border border-slate-100 w-64" uk-drop="offset:8;pos: bottom-right;animate-out: true;">

					<a>
						<div class="p-4 py-4 flex items-center gap-3 hover:bg-slate-50 transition-colors duration-150 rounded-t-xl">
							<img src="~/images/avatar/person.png" class="w-10 h-10 rounded-xl shadow-sm object-cover" />
							<div class="flex-1 min-w-0">
								<h4 class="text-sm font-semibold text-slate-800 truncate">Long Doan</h4>
								<div class="text-xs mt-0.5 text-sky-600 truncate">doanhailong520@gmail.com</div>
							</div>
						</div>
					</a>
					<hr class="border-slate-100" />
					<nav class="p-2">
						<a>
							<div class="flex items-center gap-2.5 hover:bg-slate-100 active:bg-slate-200 p-2.5 px-3 rounded-lg transition-colors duration-150 text-slate-600 hover:text-slate-800">
								<ion-icon name="settings-outline" class="text-lg"></ion-icon> My Account
							</div>
						</a>
						<hr class="border-slate-100 my-1" />
						<a>
							<div class="flex items-center gap-2.5 hover:bg-red-50 active:bg-red-100 p-2.5 px-3 rounded-lg transition-colors duration-150 text-slate-600 hover:text-red-600">
								<ion-icon name="exit-outline" class="text-lg"></ion-icon> Log Out

							</div>
						</a>
					</nav>
				</div>
			</div>
		</div>
	</div>
</header>
